# Copiado automaticamente por scripts/setup.sh — não edites manualmente se não souberes

# ID do projecto Google Cloud (ex: ecoom-ads-123456)
GOOGLE_CLOUD_PROJECT=

# Região Vertex AI (global ou us-central1 — o setup escolhe automaticamente)
GOOGLE_CLOUD_LOCATION=global

# Bucket GCS para vídeos gerados (ex: gs://ecoom-ads-videos/output/)
GCS_OUTPUT_URI=

# Modelo Veo (veo-3.1-fast-generate-001 | veo-3.1-generate-001 | veo-3.1-lite-generate-001)
VEO_MODEL=veo-3.1-fast-generate-001

# Pasta local onde guardamos os MP4 descarregados
OUTPUT_DIR=./output

# Gemini — storyboard + copy (usa Vertex AI / mesmas credenciais GCP)
GEMINI_STORYBOARD_MODEL=gemini-2.5-flash

# OpenAI — opcional (futuro: trocar storyboard para GPT API)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1

# Duração de cada clip Veo (4, 6, 8 ou 10 segundos)
VEO_CLIP_DURATION=10

# Defaults do anúncio
AD_LANGUAGE=pt
AD_LANGUAGE_VARIANT=pt-BR
AD_ASPECT_RATIO=9:16
AD_RESOLUTION=1080p
AD_TONE=amigavel
AD_STYLE=ad

# Lip sync real (Sync Labs) — boca sincronizada com áudio PT-PT
# Free trial: 3 gerações/mês em https://sync.so
SYNC_LABS_API_KEY=
SYNC_LABS_MODEL=lipsync-2
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=FfDQWz2XO4Zsxl1uwh0e
ELEVENLABS_MODEL=eleven_multilingual_v2

# Nano Banana Pro — imagens hiper-realistas (UGC)
GEMINI_IMAGE_MODEL=gemini-3-pro-image
GEMINI_IMAGE_SIZE=2K

# Veo 3 — áudio nativo para PT-BR / EN; desactivar para PT-PT externo
VEO_GENERATE_AUDIO=true

# Motor de voz: veo (PT-BR/EN) | google | elevenlabs (só PT-PT)
TTS_ENGINE=veo
GOOGLE_TTS_VOICE=pt-PT-Wavenet-B

# Reescrita automática de prompt (como Flow Labs) — default: true
VEO_ENHANCE_PROMPT=true

# Prompt Veo — en recomendado para PT-BR; pt-PT quando voltarmos ao europeu
VEO_PROMPT_LOCALE=en

# Transição fluida entre clips Veo (segundos de crossfade FFmpeg)
VIDEO_CROSSFADE_SECONDS=0.35

# ── Deploy ────────────────────────────────────────────────────────
# API (VPS)
PORT=8787
FRONTEND_URL=https://teu-app.vercel.app

# Frontend (Vercel) — definir em web/.env.local ou Vercel dashboard
# NEXT_PUBLIC_API_URL=https://api.teu-dominio.com
